{"reciters":[{"key":"ar.husary","name":"الشيخ محمود خليل الحصري"},{"key":"ar.minshawi","name":"الشيخ محمد صديق المنشاوي"},{"key":"ar.alafasy","name":"الشيخ مشاري العفاسي"},{"key":"ar.abdulbasitmurattal","name":"الشيخ عبد الباسط عبد الصمد"},{"key":"ar.mahermuaiqly","name":"الشيخ ماهر المعيقلي"}],"surahs":[{"number":1,"name":"الفَاتِحَة","englishName":"Al-Faatiha","ayahs":[{"n":1,"g":1,"text":"﻿بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ"},{"n":2,"g":2,"text":"ٱلْحَمْدُ لِلَّهِ رَبِّ ٱلْعَٰلَمِينَ"},{"n":3,"g":3,"text":"ٱلرَّحْمَٰنِ ٱلرَّحِيمِ"},{"n":4,"g":4,"text":"مَٰلِكِ يَوْمِ ٱلدِّينِ"},{"n":5,"g":5,"text":"إِيَّاكَ نَعْبُدُ وَإِيَّاكَ نَسْتَعِينُ"},{"n":6,"g":6,"text":"ٱهْدِنَا ٱلصِّرَٰطَ ٱلْمُسْتَقِيمَ"},{"n":7,"g":7,"text":"صِرَٰطَ ٱلَّذِينَ أَنْعَمْتَ عَلَيْهِمْ غَيْرِ ٱلْمَغْضُوبِ عَلَيْهِمْ وَلَا ٱلضَّآلِّينَ"}]},{"number":106,"name":"قُرَيْش","englishName":"Quraish","ayahs":[{"n":1,"g":6194,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ لِإِيلَٰفِ قُرَيْشٍ"},{"n":2,"g":6195,"text":"إِۦلَٰفِهِمْ رِحْلَةَ ٱلشِّتَآءِ وَٱلصَّيْفِ"},{"n":3,"g":6196,"text":"فَلْيَعْبُدُوا۟ رَبَّ هَٰذَا ٱلْبَيْتِ"},{"n":4,"g":6197,"text":"ٱلَّذِىٓ أَطْعَمَهُم مِّن جُوعٍۢ وَءَامَنَهُم مِّنْ خَوْفٍۭ"}]},{"number":111,"name":"المَسَد","englishName":"Al-Masad","ayahs":[{"n":1,"g":6217,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ تَبَّتْ يَدَآ أَبِى لَهَبٍۢ وَتَبَّ"},{"n":2,"g":6218,"text":"مَآ أَغْنَىٰ عَنْهُ مَالُهُۥ وَمَا كَسَبَ"},{"n":3,"g":6219,"text":"سَيَصْلَىٰ نَارًۭا ذَاتَ لَهَبٍۢ"},{"n":4,"g":6220,"text":"وَٱمْرَأَتُهُۥ حَمَّالَةَ ٱلْحَطَبِ"},{"n":5,"g":6221,"text":"فِى جِيدِهَا حَبْلٌۭ مِّن مَّسَدٍۭ"}]},{"number":112,"name":"الإِخْلاَص","englishName":"Al-Ikhlaas","ayahs":[{"n":1,"g":6222,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ قُلْ هُوَ ٱللَّهُ أَحَدٌ"},{"n":2,"g":6223,"text":"ٱللَّهُ ٱلصَّمَدُ"},{"n":3,"g":6224,"text":"لَمْ يَلِدْ وَلَمْ يُولَدْ"},{"n":4,"g":6225,"text":"وَلَمْ يَكُن لَّهُۥ كُفُوًا أَحَدٌۢ"}]},{"number":113,"name":"الفَلَق","englishName":"Al-Falaq"